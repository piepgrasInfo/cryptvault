<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used by nothing unless the user switches crash reporting on in Settings.
         See CrashReporting.kt for why the SDK cannot start on its own. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Checks connectivity before attempting a request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Runtime permission on API 33+. Request it lazily, at the point the user
         first asks for something that needs a notification - not at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Backup and restore runs the user starts (WorkManager setForeground, type dataSync). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Normal permission (no prompt): lets the app hide other apps' overlay windows above its
         own, so nothing can be drawn over the unlock screen (BUILD_BRIEF.md §4.4). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Android 17+: reaching a WebDAV server on the local network (a home Nextcloud or NAS) needs
         this runtime permission; asked for at the point of use, only when the host is local. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Package visibility: a camera app for the Capture entry, and viewers/editors/share
         targets for the open-with and share flows (Android 11+ hides them otherwise). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <supports-screens
        android:anyDensity="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <!-- No device backup or transfer: a vault is only readable with its password, the
         biometric wrap lives in the Keystore and never transfers, and the app's own state is
         a registry that a restore would leave pointing at vaults that are not there. CryptVault's
         own backup (BUILD_BRIEF.md §6) is the way a vault survives a phone. -->
    <!-- No android:roundIcon: it is only read below API 26 and minSdk is 26, so every
         launcher takes @mipmap/ic_launcher's adaptive form and applies its own mask. -->
    <application
        android:name=".CryptVaultApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CryptVault"
        android:supportsRtl="true">

        <!-- Stops the Sentry SDK starting itself from its own ContentProvider. Without
             this it would be running before the user has had any chance to refuse,
             which is the entire point of the opt-in. The DSN is passed in code
             (CrashReporting.kt) for the same reason. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />

        <!-- singleTask: a share into the app reaches the running instance through onNewIntent
             instead of stacking a second copy of the app on top of the first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to CryptVault" from any app (BUILD_BRIEF.md §2.3). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Received containers (BUILD_BRIEF.md §7.4): mail apps hand over content:// URIs with
                 generic types, so octet-stream is accepted; the kind is decided by content. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/pgp-encrypted" />
                <data android:mimeType="application/vnd.age" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The unlocked vaults as storage roots for the system file picker and the Files app
             (BUILD_BRIEF.md §5.2). MANAGE_DOCUMENTS is a system-only permission on the provider
             element: only the platform's document UI and pickers can talk to it. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <provider
            android:name=".provider.VaultDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Lets the app hand generated files to any other app (mail, Drive, Files...)
             through the share sheet without asking for storage permissions. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
